{
  "source": "https://docs.tavily.com/documentation/api-reference/endpoint/search.md",
  "endpoint": "https://api.tavily.com/search",
  "method": "POST",
  "auth": {"in": "header", "name": "Authorization", "secret": "TAVILY_API_KEY", "scheme": "Bearer"},
  "required_request": ["query"],
  "optional_request": [
    "search_depth",
    "chunks_per_source",
    "max_results",
    "topic",
    "time_range",
    "start_date",
    "end_date",
    "include_published_date",
    "filter_by_published_date",
    "include_answer",
    "include_raw_content",
    "include_images",
    "include_image_descriptions",
    "include_favicon",
    "include_domains",
    "exclude_domains",
    "include_domains_mode",
    "country",
    "language",
    "filter_by_language",
    "auto_parameters",
    "exact_match",
    "include_usage",
    "safe_search"
  ],
  "wrapper_headers": ["project_id", "session_id", "human_id"],
  "wrapper_inputs": [
    "hire_id",
    "query",
    "search_depth",
    "chunks_per_source",
    "max_results",
    "topic",
    "time_range",
    "start_date",
    "end_date",
    "include_published_date",
    "filter_by_published_date",
    "include_answer",
    "include_raw_content",
    "include_images",
    "include_image_descriptions",
    "include_favicon",
    "include_domains",
    "exclude_domains",
    "include_domains_mode",
    "country",
    "language",
    "filter_by_language",
    "auto_parameters",
    "exact_match",
    "include_usage",
    "safe_search",
    "project_id",
    "session_id",
    "human_id"
  ],
  "required_response": ["query", "results", "images", "response_time", "answer"],
  "result_required": ["title", "url", "content", "score"],
  "search_depths": ["advanced", "basic", "fast", "ultra-fast"],
  "topics": ["general", "news", "finance"],
  "bounds": {
    "max_query_chars": 400,
    "max_domains": 20,
    "max_results": 10,
    "runner_result_bytes": 65536,
    "runner_data_target_bytes": 60000,
    "result_bytes": 38000
  }
}
