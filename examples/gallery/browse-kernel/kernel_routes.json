{
  "source": "https://docs.onkernel.com/api-reference/invocations/create-invocation",
  "docs_version": "2026-09",
  "endpoint": "https://api.onkernel.com/invocations",
  "method": "POST",
  "operation": "create-invocation",
  "auth": {"in": "header", "name": "Authorization", "secret": "KERNEL_API_KEY", "scheme": "Bearer"},
  "idempotency": {"in": "header", "name": "Idempotency-Key", "on": "mutating step ops (open, goto, click, type, press, scroll, close)"},
  "app": "cowboy-browse",
  "actions": ["visit", "step"],
  "step_ops": ["open", "goto", "click", "type", "press", "scroll", "extract", "close"],
  "mutating_ops": ["open", "goto", "click", "type", "press", "scroll", "close"],
  "readonly_ops": ["extract", "visit"],
  "request_body": {"content_type": "application/json", "fields": ["app_name", "action_name", "payload"]},
  "visit_payload_fields": ["url"],
  "step_payload_fields": ["op", "session_id", "url", "selector", "text", "key", "dy", "stealth", "timeout_seconds"],
  "payload_is_json_string": true,
  "session_owner": "actor (per-hire); the caller never supplies session_id",
  "response_envelope": ["action_name", "id", "status", "output"],
  "success": "status == succeeded AND output(json string).ok == true",
  "result_path": "output(json string).{ok,session_id?,url,title,text,links,closed?}",
  "error_envelope": ["status", "code", "message"],
  "visit_inputs": ["hire_id", "url"],
  "step_inputs": ["hire_id", "op", "url", "selector", "text", "key", "dy", "stealth", "timeout_seconds"],
  "bounds": {
    "max_url_chars": 2048,
    "max_selector_chars": 1024,
    "max_text_chars": 4096,
    "max_request_bytes": 8000,
    "runner_result_bytes": 65536,
    "result_bytes": 38000,
    "text_bytes": 34000,
    "max_links": 40,
    "max_active_sessions": 8
  }
}
