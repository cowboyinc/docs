# Devnet credential template for cowbot.
#
# Copy to `.env` (gitignored) on the host that runs deploy.sh / the runner,
# then `source .env` before invoking. The Slack values are CBSS secrets
# (CIP-24 §5.5): deploy.sh provisions them owned by the deployer EOA and
# ACL'd to the actor; they are never env vars on the runner or gateway.

# ── Required for `deploy.sh` ────────────────────────────────────────────────

# Path to the deployer's private key file (hex, no 0x prefix).
COWBOY_PRIVATE_KEY=/path/to/your-key.hex

# Hex-encoded public key of the deployer (matches private key above). Used
# by `cowboy actor address` to derive the deterministic CREATE2 address
# without signing a tx.
COWBOT_CREATOR_PUBKEY=04abcdef...

# Optional CREATE2 salt; bump if you want a fresh actor instance without
# upgrading code. Default in deploy.sh: 0xc0
# COWBOT_SALT=0xc0

# ── CBSS secrets provisioned by deploy.sh Step 4c (CIP-24 §5.5) ─────────────

# Slack bot OAuth token (xoxb-...). Provisioned as the CBSS secret
# SLACK_BOT_TOKEN, owned by the deployer EOA and ACL'd to the actor. The
# runner substitutes ${SLACK_BOT_TOKEN} into the outbound chat.postMessage
# (`secrets=` read set); the actor never stores it.
COWBOT_SLACK_BOT_TOKEN=xoxb-...

# Slack signing secret — from the Slack app's Basic Information → App
# Credentials → Signing Secret. Provisioned as the CBSS secret
# SLACK_SIGNING_SECRET (verify-only, `secrets.verify`): the runner MAC-
# verifies inbound webhooks with it via the first runner.http `verify=`;
# it is never substituted into a request and never stored in the actor.
COWBOT_SLACK_SIGNING_SECRET=...

# ── Required on each runner host ────────────────────────────────────────────

# Moonshot Kimi K2 API key — read by AgentExecutor when JobType::Agent
# arrives with `model="kimi-k2"`. Swap for DASHSCOPE_API_KEY (Qwen3-Coder),
# DEEPSEEK_API_KEY (DeepSeek-V3), or SELF_HOSTED_LLM_KEY (llama.cpp) per
# the model in cowbot.py's DEFAULT_MODEL. The LLM inference key is NOT a
# CBSS secret.
MOONSHOT_API_KEY=sk-...

# ── Gateway convenience ──────────────────────────────────────────────────────

# Cowbot actor address printed by deploy.sh. Only used by the gateway
# bootstrap scripts to print the Slack Request URL — the gateway itself is
# untrusted plumbing and holds no secret.
COWBOT_ACTOR=0x...
