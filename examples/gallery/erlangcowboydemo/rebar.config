{erl_opts, [debug_info, warn_unused_vars, warn_export_all]}.

{deps, []}.

{shell, [
  % Start the app automatically in rebar3 shell
  {apps, [erlangcowboydemo]}
]}.

{escript_main_app, erlangcowboydemo}.
{escript_name, erlangcowboydemo}.
{escript_emu_args, "%%! -sname demo +pc unicode\n"}.
{escript_incl_apps, [erlangcowboydemo]}.
